# Algolia application ID.
ALGOLIA_APPLICATION_ID=
# Search-only or secured key for the raw Search baseline.
ALGOLIA_SEARCH_API_KEY=
# Direct Agent Studio API key with the required permissions.
ALGOLIA_AGENT_STUDIO_API_KEY=
# Server-only Agent Studio management key with settings/editSettings ACLs for create/update/publish.
ALGOLIA_AGENT_STUDIO_MANAGEMENT_API_KEY=
# Server-only key with addObject, settings, and editSettings ACLs for verification/copy operations.
ALGOLIA_INDEXING_API_KEY=
# Written by npm run provision.
LATENCY_BENCHMARK_AGENT_STUDIO_AGENT_ID=
ALGOLIA_INDEX_NAME=
# Destination for the controlled copy, created by npm run provision.
ALGOLIA_BENCHMARK_COPY_INDEX=agent_studio_latency_copy
# Required only when the script creates an agent.
AGENT_STUDIO_PROVIDER_ID=
AGENT_STUDIO_MODEL=
AGENT_STUDIO_AGENT_NAME=Agent Studio latency benchmark
PUBLISH_AGENTS=false
# Refuse to replace an existing copy unless this is explicitly true.
ALLOW_INDEX_OVERWRITE=false
# Written by npm run provision from the supplied product index and generated copy index.
BENCHMARK_INDEX_TARGETS=
# Path to a local, non-sensitive newline-delimited query file.
BENCHMARK_QUERY_FILE=queries.example.ndjson
BENCHMARK_ITERATIONS=10
BENCHMARK_CONCURRENCY=1
BENCHMARK_WARMUPS=2
BENCHMARK_TIMEOUT_MS=60000
BENCHMARK_DATA_LABEL=synthetic-controlled
BENCHMARK_OUTPUT_DIR=results
# Use demo mode for a public or blog deployment unless live runs are intentionally enabled.
BENCHMARK_WEB_MODE=demo
# Optional for `npm run provision -- --sync-vercel`; prefer exporting it in the shell.
# VERCEL_TOKEN=
# Optional if this checkout is not linked with `vercel link`.
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
